[submodule "Binaries"]
	path = Binaries
	url = https://github.com/xl841376-netizen/Device-Binaries.git
	# crux: 上游 Device-Binaries 无 crux 目录，改用本项目 fork 的 crux-binaries 分支
	branch = crux-binaries
[submodule "Common/Mu"]
	path = Common/Mu
	url = https://github.com/microsoft/mu_plus.git
	branch = release/202608
[submodule "Common/Mu_OEM_Sample"]
	path = Common/Mu_OEM_Sample
	url = https://github.com/microsoft/mu_oem_sample.git
	branch = release/202608
[submodule "Mu_Basecore"]
	path = Mu_Basecore
	url = https://github.com/microsoft/mu_basecore.git
	branch = release/202608
[submodule "Silicium-ACPI"]
	path = Silicium-ACPI
	url = https://github.com/xl841376-netizen/Silicium-ACPI.git
	# crux: 上游 Silicium-ACPI 的 Xiaomi 平台里没有 crux，改用本项目 fork 的 crux-acpi 分支
	branch = crux-acpi
[submodule "Silicon/Silicium/OpensslPkg/Library/OpensslLib/openssl"]
	path = Silicon/Silicium/OpensslPkg/Library/OpensslLib/openssl
	url = https://github.com/openssl/openssl.git
